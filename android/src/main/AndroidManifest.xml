<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No "package" attribute here — AGP 8+ ignores/errors on it.
         The applicationId/namespace now comes from build.gradle's `namespace` field. -->

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Removed: <activity com.uhfrfidlibrary.uhf.activity.UHFMainActivity>,
      <receiver com.uhfrfidlibrary.uhf.BootBroadcastReceiver>, and
      <activity com.uhfrfidlibrary.uhf.filebrowser.FileManagerActivity>.

      These were leftovers from the vendor's standalone demo app. This module
      is an `com.android.library` (a React Native native module), and none of
      those three classes exist in this codebase — Manifest merger will fail
      the host app's build the moment this library gets autolinked, since it
      can't find them. If you actually need USB auto-launch behaviour
      (device_filter.xml), that intent-filter + meta-data belongs on YOUR
      APP's main launcher activity, not in this library — happy to add that
      snippet for your app's manifest if you want it.
    -->

</manifest>
